{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_OUTPUT_STYLE": "Explanatory",
    "CLAUDE_CODE_THINKING": "true"
  },
  "mcpServers": {
    "obsidian": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "obsidian-mcp-server"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL}",
        "OBSIDIAN_VERIFY_SSL": "false"
      }
    },
    "pinecone": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@pinecone-database/mcp"
      ],
      "env": {
        "PINECONE_API_KEY": "${PINECONE_API_KEY}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/security_prefilter.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/budget_check.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/validate-env.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Add-Content '.claude/agent-log.txt' ('[AGENT START] ' + (Get-Date -Format 'HH:mm:ss') + ' — Agent demarre')\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Add-Content '.claude/agent-log.txt' ('[AGENT STOP] ' + (Get-Date -Format 'HH:mm:ss') + ' — Agent termine')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/stop_check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/inbox_inject.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/inbox_watcher.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/caste/Desktop/Espace_Opti/.claude/hooks/session-start-phase0.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git tag*)",
      "Bash(git branch*)",
      "Bash(python sync_memory.py)",
      "Bash(python -m graphify*)",
      "Bash(python .claude/hooks/*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npx claude-mem*)",
      "Bash(python -m pytest*)",
      "Bash(npx playwright*)",
      "Edit(/src/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Edit(*.md)",
      "Write(*.md)",
      "Write(/src/**)",
      "Write(/tests/**)"
    ],
    "deny": [
      "mcp__code-review__*",
      "mcp__code-simplifier__*",
      "mcp__security-guidance__*",
      "mcp__frontend-design__*"
    ]
  }
}